# Copy to .env in the project root to configure Docker Compose.
# These defaults are for local development only; never use them in production.
MYSQL_ROOT_PASSWORD=striker-local-dev

# Optional: provide credentials from your own GHN account.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=1482

# Optional: provide credentials from one MoMo Sandbox account.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=payWithATM
MOMO_REDIRECT_URL=http://localhost:8000/api/payment/momo/callback
MOMO_IPN_URL=http://localhost:8000/api/payment/momo/ipn

# Local-only shared secret used between payment-service and order-service.
PAYMENT_SERVICE_SECRET=local-docker-only-change-before-deploy
